@{ 
    Layout = null;
    ViewBag.Title = "Recuperar Cuenta";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aplicativo de Gestióm de Ingresos</title>

    <link rel="icon" type="image/png" href="../../Assets/images/icono_dinero.png" />

    <!-- Google Font -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="../../Assets/plantilla/AdminLTE-3.2.0/plugins/fontawesome-free/css/all.min.css">

    <!-- icheck -->
    <link rel="stylesheet" href="../../Assets/plantilla/AdminLTE-3.2.0/plugins/icheck-bootstrap/icheck-bootstrap.min.css">

    <!-- AdminLTE -->
    <link rel="stylesheet" href="../../Assets/plantilla/AdminLTE-3.2.0/dist/css/adminlte.min.css">

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="hold-transition login-page">

    @if (TempData["mensaje"] != null)
    {
        <script>
                Swal.fire({
                    position: 'top-end',
                    icon: '@TempData["icono"]',
                    title: '@TempData["mensaje"]',
                    showConfirmButton: false,
                    timer: 3000
                });
        </script>
    }

    <div class="wrapper">

        <br /><br /><br />

        <div class="login-box">

            <div class="login-logo">
                <a href="#">
                    <h4><b>RECUPERAR CUENTA</b></h4>
                </a>
            </div>

            <div class="card">

                <div class="card-body login-card-body">

                    <p class="login-box-msg">
                        ¿Olvidaste tu contraseña? <br />
                        Digite su usuario para enviarle un correo de restablecimiento.
                    </p>

                    <form action="@Url.Action("Recuperar", "Account")" method="post">

                        <div class="input-group mb-3">

                            <input type="text" name="usuario" class="form-control"
                                   placeholder="Usuario" required />

                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-user"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-primary btn-block">
                                    Solicitar nueva contraseña
                                </button>

                                <a href="@Url.Action("Login","Account")"
                                   class="btn btn-warning btn-block">
                                    Volver
                                </a>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="../../Assets/plantilla/AdminLTE-3.2.0/plugins/jquery/jquery.min.js"></script>
    <script src="../../Assets/plantilla/AdminLTE-3.2.0/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../../Assets/plantilla/AdminLTE-3.2.0/dist/js/adminlte.min.js"></script>

</body>
</html>
