@{ 
    string AppName = System.Configuration.ConfigurationManager.AppSettings["AppName"].ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Aplicativo de Gestión de Ingresos</title>


    <link rel="icon" type="image/png" href="../../Assets/images/icono_dinero.png" />

    <!--Graficos google charts en linea-->
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    <!--Select 2 - Bootstrap 4-->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @Styles.Render("~/content/css")
    @Styles.Render("~/content/datetime")
    @Styles.Render("~/content/select")
    @Styles.Render("~/content/fonts")

    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Assets/jquery/jquery.unobtrusive-ajax.js")"></script>


    <!-- Libreria Sweetallert2-->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>



<style>
    header .navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 60px; /* altura del header */
        z-index: 1030;
    }


    #sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 250px;
        height: 100vh;
        padding-top: 60px; /* ← espacio interno en vez de moverlo */
    }

    .content-wrapper {
        margin-top: 60px; /* espacio para el header */
        margin-left: 250px; /* espacio para sidebar */
        padding: 0px;
    }

    .main-footer {
        margin-left: 250px;
    }

    /* Cuando el sidebar se colapsa */
    body.sidebar-collapse #sidebar {
        width: 70px;
    }

    body.sidebar-collapse .content-wrapper,
    body.sidebar-collapse .main-footer {
        margin-left: 70px;
    }
</style>




<body class="sidebar-collapse">
    <header>
        <nav class="navbar navbar-expand navbar-light " style="background-color: #ff6a00; color: white;">
            @if (Request.IsAuthenticated)
            {
                <a class="sidebar-toggle" href="javascript:;" id="toggle-menu"><i class="fa fa-bars"></i></a>
            }

            <a class="navbar-brand" href="#">
                <img class="img-fluid" style="max-width: 125px;" src="~/Assets/images/logo_main.png" alt="UNFV">
            </a>
            <a class="navbar-brand navbar-title d-none d-sm-inline-block" style="color: white" href="@Url.Action("Index", "Home")" rel="home" title="Universidad Nacional Federico Villarreal">
                @AppName
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            @if (Request.IsAuthenticated)
            {
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ml-auto">
                        <!-- <li class="nav-item">
                          <a class="nav-link" href="#"><i class="fa fa-bell"></i></a>
                        </li> -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle active" style="color: white; font-size: 18px;" href="#" id="navbarDropdown" role="button" data-toggle="dropdown"
                               aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-user-circle">&nbsp;</i>  @Session["NombreCompleto"]
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">

                                <a class="dropdown-item" href="#"><i class="fa fa-fw fa-user-circle">&nbsp;</i>Usuario: @Session["NombreUsuario"]</a>

                                <a class="dropdown-item modal-link" href="@Url.Action("CambiarPassword", "Account", new { area = "" })"><i class="fa fa-fw fa-key">&nbsp;</i>Cambiar Contraseña</a>
                                <!--<a class="dropdown-item" href="@Url.Action("Index", "HelpCenter")"><i class="fa fa-fw fa-life-ring">&nbsp;</i>Ayuda</a>-->
                                <div class="dropdown-divider"></div>
                                @using (Html.BeginForm("LogOut", "Account", new { area = "" }, FormMethod.Post, new { id = "LogOutForm", @class = "text-center" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <a class="dropdown-item bg-red " href="javascript:document.getElementById('LogOutForm').submit()">
                                        <i class="fa fa-fw fa-power-off">&nbsp;</i>Cerrar Sesión
                                    </a>
                                }

                            </div>
                        </li>
                    </ul>
                </div>
            }
        </nav>
    </header>

    <main class="wrapper">
        @if (Request.IsAuthenticated)
        {
            <div id="sidebar">
                @Html.Partial("_Sidebar")
            </div>
        }
        <div class="content-wrapper pt-3">
            @RenderBody()
        </div>
    </main>
    <footer class="main-footer">
        <div class="container-fluid">
            <!--<p class="text-muted">&copy @DateTime.Now.Year Elaborado por <a href="https://www.unfv.edu.pe/">OCGTI - UNFV</a></p>-->
            <p class="text-muted">
                <a href="https://www.unfv.edu.pe/" target="_blank">UNFV - OCGTI</a> &copy; Copyright @DateTime.Now.Year - Todos los Derechos Reservados
            </p>
        </div>
    </footer>

    <div class="modal fade" id="modal-container" tabindex="-1" role="dialog" aria-labelledby="modal-container-label" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-container-lg" tabindex="-1" role="dialog" aria-labelledby="modal-container-label" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>
            </div>
        </div>
    </div>


    <div class="modal fade" id="modal-container-xl" tabindex="-1" role="dialog" aria-labelledby="modal-container-label" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>
            </div>
        </div>
    </div>


    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/datetime")
    @Scripts.Render("~/bundles/select")
    @Scripts.Render("~/bundles/app")
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@10"></script>

    @RenderSection("scripts", required: false)



    <script type="text/javascript">
        $(function () {
            $('body').on('click', '.modal-link', function (e) {
                e.preventDefault();
                $(this).attr('data-target', '#modal-container');
                $(this).attr('data-toggle', 'modal');
            });

            $('body').on('click', '.modal-link-lg', function (e) {
                e.preventDefault();
                $(this).attr('data-target', '#modal-container-lg');
                $(this).attr('data-toggle', 'modal');
            });

            $('body').on('click', '.modal-link-xl', function (e) {
                e.preventDefault();
                $(this).attr('data-target', '#modal-container-xl');
                $(this).attr('data-toggle', 'modal');
            });

            $('#modal-container-lg').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.attr("href");
                var modal = $(this);
                modal.find('.modal-content').load(url);
            });

            $('#modal-container-xl').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.attr("href");
                var modal = $(this);
                modal.find('.modal-content').load(url);
            });

            $('#modal-container').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var url = button.attr("href");
                var modal = $(this);
                modal.find('.modal-content').load(url);
            });

            $('#modal-container').on('hide.bs.modal', function () {
                $(this).removeData('bs.modal');
                //$('#modal-container .modal-dialog').removeClass('modal-lg')
                $('#modal-container .modal-content').html('<p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>');
            });

            $('#modal-container-lg').on('hide.bs.modal', function () {
                $(this).removeData('bs.modal');
                $('#modal-container-lg .modal-content').html('<p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>');
            });

            $('#modal-container-xl').on('hide.bs.modal', function () {
                $(this).removeData('bs.modal');
                $('#modal-container-xl .modal-content').html('<p style="margin:50px;" class="text-center text-muted"><i class="fa fa-spin fa-3x fa-cog"></i></p>');
            });

            $('.select-filter').select2({
                theme: 'bootstrap4',
                placeholder: 'SELECCIONAR',
                allowClear: true
            });

            $('[data-toggle="tooltip"]').tooltip()
        });
    </script>

    @if (TempData["mensaje"] != null)
    {
        <script>
            Swal.fire({
                position: 'top-end',
                icon: '@TempData["icono"]',
                title: '@TempData["mensaje"]',
                showConfirmButton: false,
                timer: 3000
            });
        </script>
    }


</body>
</html>